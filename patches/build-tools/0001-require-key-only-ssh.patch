+mkdir -p system/usr/local/sbin
+cat >system/usr/local/sbin/d2s-static-rndis-network <<'EOF'
+#!/bin/sh
+set -eu
+
+tries=0
+netdev=""
+while [ -z "$netdev" ]; do
+    for candidate in usb0 rndis0; do
+        if ip link show "$candidate" >/dev/null 2>&1; then
+            netdev="$candidate"
+            break
+        fi
+    done
+    [ -n "$netdev" ] && break
+    tries=$((tries + 1))
+    [ "$tries" -lt 60 ] || exit 1
+    sleep 1
+done
+
+ip link set dev "$netdev" up
+ip address replace 10.15.19.82/24 dev "$netdev"
+install -d -m 0755 /var/lib/dhcp
+touch /var/lib/dhcp/dhcpd.leases
+exec /usr/sbin/dhcpd -4 -f -q \
+    -cf /etc/hybris-usb/dhcpd.conf \
+    -pf /run/d2s-static-rndis-dhcpd.pid "$netdev"
