+# Morph's QtWebEngine migration left the old Oxide per-site UA assignment as
+# a write to an undefined QML global. Repair the profile API, use a supported
+# YouTube identity, and translate Android intent URLs back to HTTPS.
+patch --batch --forward -d system -p1 < \
+    "$HERE/runtime-fixes/morph-youtube-focal.patch"
+grep -q 'property var userAgentOverrides' \
+    system/usr/lib/aarch64-linux-gnu/qt5/qml/Morph/Web/MorphWebContext.qml
