+ExecStart=/usr/local/sbin/d2s-static-rndis-network
+Restart=on-failure
+RestartSec=2
+
+[Install]
+WantedBy=multi-user.target
+EOF
+ln -sfn /etc/systemd/system/d2s-static-rndis-network.service \
