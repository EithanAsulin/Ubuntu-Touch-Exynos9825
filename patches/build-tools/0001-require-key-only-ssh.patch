+load-module module-droid-card-29 module_id=primary voice_virtual_stream=true config=/etc/pulse/d2s-audio-policy.xml\
+load-module module-droid-hidl helper=false' \
+    system/etc/pulse/touch.pa
+grep -q '^load-module module-droid-card-29 .*d2s-audio-policy.xml$' \
+    system/etc/pulse/touch.pa
