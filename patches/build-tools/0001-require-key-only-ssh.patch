+    system/usr/lib/waydroid/data/scripts/waydroid-net.sh
+ln -sfn /etc/systemd/system/d2s-waydroid-offline-init.service \
+    system/etc/systemd/system/multi-user.target.wants/d2s-waydroid-offline-init.service
